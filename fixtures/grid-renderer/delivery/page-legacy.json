      },
      {
        "padding": 0,
        "lineHeight": 1.2,
        "id": "markdown-11",
        "kind": "text",
        "name": "Where to start.",
        "text": "## Where to start.",
        "assetId": null,
        "frame": {
          "x": 0,
          "y": 11,
          "width": 12,
          "height": 1
        },
        "frames": {},
        "color": "transparent",
