    {
      "padding": 0,
      "lineHeight": 1.5,
      "id": "markdown-10",
      "kind": "text",
      "name": "Agents with Memory access use the `memory_*asset*` tools;…",
      "text": "Agents with Memory access use the `memory_*asset*` tools; the CLI has matching commands: `assets` to list or search, `add-asset` to add a new one, `upload-asset` to replace one, `download-asset` to save a version, and `update-asset` for names and tags. Uploads use a request ID so a retry doesn’t create a duplicate.",
      "assetId": null,
      "frame": {
        "x": 0,
        "y": 10,
        "width": 12,
        "height": 1
      },
      "frames": {},
      "color": "transparent",
      "background": "transparent",
