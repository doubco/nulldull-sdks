      "shape": "rectangle",
      "hidden": false
    },
    {
      "padding": 0,
      "lineHeight": 1.5,
      "id": "markdown-11",
      "kind": "text",
      "name": "Downloaded copies are yours to manage. Revoking access…",
      "text": "Downloaded copies are yours to manage. Revoking access stops future downloads but cannot erase copies already on someone’s machine.",
      "assetId": null,
      "frame": {
