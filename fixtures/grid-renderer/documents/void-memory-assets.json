      "shape": "rectangle",
      "hidden": false
    },
    {
      "padding": 0,
      "lineHeight": 1.2,
      "id": "markdown-9",
      "kind": "text",
      "name": "From the CLI and MCP.",
      "text": "## From the CLI and MCP.",
      "assetId": null,
      "frame": {
        "x": 0,
        "y": 9,
        "width": 12,
