      "hidden": false
    },
    {
      "padding": 0,
      "lineHeight": 1.2,
      "id": "markdown-3",
      "kind": "text",
      "name": "Keep different libraries distinct.",
      "text": "## Keep different libraries distinct.",
      "assetId": null,
      "frame": {
        "x": 0,
        "y": 3,
        "width": 12,
        "height": 1
      },
      "frames": {},
      "color": "transparent",
