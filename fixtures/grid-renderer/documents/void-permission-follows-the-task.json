    {
      "padding": 0,
      "lineHeight": 1.5,
      "id": "markdown-2",
      "kind": "text",
      "name": "Before connecting an agent, choose the workspace and the…",
      "text": "Before connecting an agent, choose the workspace and the capabilities the task needs. Avoid treating a successful sign-in as permission to every resource.",
      "assetId": null,
      "frame": {
        "x": 0,
        "y": 2,
        "width": 12,
        "height": 1
      },
      "frames": {},
      "color": "transparent",
