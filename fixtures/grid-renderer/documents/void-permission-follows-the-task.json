      "id": "markdown-1",
      "kind": "text",
      "name": "Reading a project overview is different from replacing its…",
      "text": "Reading a project overview is different from replacing its deployment instructions. Drafting a proposal is different from approving another person’s changes. Access should describe those differences.",
      "assetId": null,
      "frame": {
        "x": 0,
        "y": 1,
        "width": 12,
        "height": 1
      },
      "frames": {},
