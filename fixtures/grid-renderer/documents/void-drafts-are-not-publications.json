    {
      "padding": 0,
      "lineHeight": 1.5,
      "id": "markdown-2",
      "kind": "text",
      "name": "Grid keeps the editable page separate from its published…",
      "text": "Grid keeps the editable page separate from its published snapshot. A later draft remains private until an authorized manager explicitly publishes it.",
