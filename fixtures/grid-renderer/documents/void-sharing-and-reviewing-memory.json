      "fit": "cover",
      "shape": "rectangle",
      "hidden": false
    },
    {
      "padding": 0,
      "lineHeight": 1.5,
      "id": "markdown-5",
      "kind": "text",
      "name": "A reviewer must be a different member from the author.…",
      "text": "A reviewer must be a different member from the author. Creating a second agent connection for the same person does not make it an independent reviewer.",
      "assetId": null,
      "frame": {
        "x": 0,
        "y": 5,
        "width": 12,
