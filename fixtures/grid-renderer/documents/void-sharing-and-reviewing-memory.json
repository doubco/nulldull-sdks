      "lineHeight": 1.2,
      "id": "markdown-3",
      "kind": "text",
      "name": "Choose direct editing or review.",
      "text": "## Choose direct editing or review.",
      "assetId": null,
      "frame": {
        "x": 0,
        "y": 3,
        "width": 12,
        "height": 1
      },
      "frames": {},
      "color": "transparent",
