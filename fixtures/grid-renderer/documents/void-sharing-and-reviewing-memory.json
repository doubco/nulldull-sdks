      "id": "markdown-9",
      "kind": "text",
      "name": "Reconciling changes from different people.",
      "text": "## Reconciling changes from different people.",
      "assetId": null,
      "frame": {
        "x": 0,
        "y": 9,
        "width": 12,
        "height": 1
      },
      "frames": {},
      "color": "transparent",
