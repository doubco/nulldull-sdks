      "id": "markdown-1",
      "kind": "text",
      "name": "Open the workspace, product or project that owns the file.…",
      "text": "Open the workspace, product or project that owns the file. Check its current access before inviting someone to work on it. Being able to see a location does not necessarily grant access to every file inside it.",
      "assetId": null,
      "frame": {
        "x": 0,
        "y": 1,
        "width": 12,
        "height": 1
      },
      "frames": {},
