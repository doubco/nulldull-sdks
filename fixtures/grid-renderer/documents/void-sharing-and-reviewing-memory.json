      "shape": "rectangle",
      "hidden": false
    },
    {
      "padding": 0,
      "lineHeight": 1.5,
      "id": "markdown-2",
      "kind": "text",
      "name": "An explicit file-level access rule can override a location…",
      "text": "An explicit file-level access rule can override a location default. If a colleague cannot open a file, inspect both the location assignment and that file’s own access settings.",
      "assetId": null,
      "frame": {
        "x": 0,
        "y": 2,
        "width": 12,
        "height": 1
      },
      "frames": {},
