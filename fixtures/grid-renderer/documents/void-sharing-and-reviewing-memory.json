    {
      "padding": 0,
      "lineHeight": 1.5,
      "id": "markdown-4",
      "kind": "text",
      "name": "Senior access allows direct edits. Junior access creates…",
      "text": "Senior access allows direct edits. Junior access creates proposals that require an authorized reviewer. A proposal is not the current file until it has been approved and committed.",
      "assetId": null,
      "frame": {
        "x": 0,
        "y": 4,
        "width": 12,
        "height": 1
      },
      "frames": {},
      "color": "transparent",
