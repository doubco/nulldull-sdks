      "shape": "rectangle",
      "hidden": false
    },
    {
      "padding": 0,
      "lineHeight": 1.5,
      "id": "markdown-4",
      "kind": "text",
      "name": "Values use `{{name}}` variables declared on each key.…",
      "text": "Values use `{{name}}` variables declared on each key. Import rejects undeclared or malformed placeholders.",
      "assetId": null,
