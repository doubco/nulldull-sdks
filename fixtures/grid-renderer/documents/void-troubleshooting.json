    {
      "padding": 0,
      "lineHeight": 1.5,
      "id": "markdown-6",
      "kind": "text",
      "name": "The credential is missing, expired or revoked. Run `login`…",
      "text": "The credential is missing, expired or revoked. Run `login` again and approve a new connection. Revoked or expired connections are never restored.",
      "assetId": null,
      "frame": {
        "x": 0,
        "y": 6,
        "width": 12,
