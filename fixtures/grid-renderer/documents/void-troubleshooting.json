      "fit": "cover",
      "shape": "rectangle",
      "hidden": false
    },
    {
      "padding": 0,
      "lineHeight": 1.5,
      "id": "markdown-14",
      "kind": "text",
      "name": "A `503` with `NOT_CONFIGURED` from Secrets means secret…",
      "text": "A `503` with `NOT_CONFIGURED` from Secrets means secret storage isn’t available in that environment. Don’t store the value somewhere else instead; contact info@nulldull.com.",
