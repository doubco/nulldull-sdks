    {
      "padding": 0,
      "lineHeight": 1.5,
      "id": "markdown-1",
      "kind": "text",
      "name": "Run `status` to see the origin and workspace a command…",
      "text": "Run `status` to see the origin and workspace a command uses, and `workspaces` to see every workspace you are signed in to. If the workspace you want is listed, run `use WORKSPACE_ID` in your project directory. Otherwise run `login --workspace WORKSPACE_ID` and approve it in the browser. Then restart the MCP server so the session picks up the change.",
      "assetId": null,
      "frame": {
        "x": 0,
        "y": 1,
        "width": 12,
        "height": 1
      },
      "frames": {},
      "color": "transparent",
