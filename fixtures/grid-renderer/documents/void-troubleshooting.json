      "shape": "rectangle",
      "hidden": false
    },
    {
      "padding": 0,
      "lineHeight": 1.5,
      "id": "markdown-2",
      "kind": "text",
      "name": "If the environment is wrong, check `--server` or…",
      "text": "If the environment is wrong, check `--server` or `NULLDULL_SERVER`. Each origin and workspace keeps its own login.",
      "assetId": null,
      "frame": {
        "x": 0,
