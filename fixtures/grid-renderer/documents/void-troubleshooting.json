    {
      "padding": 0,
      "lineHeight": 1.5,
      "id": "markdown-13",
      "kind": "text",
      "name": "You’ve hit a rate limit. Wait for the time given in…",
      "text": "You’ve hit a rate limit. Wait for the time given in `Retry-After`, then retry. Retry reads freely; retry writes only with the same request ID, so a write that already succeeded isn’t applied twice. Secret writes and reveals share a per-member budget and ask you to wait 60 seconds.",
      "assetId": null,
      "frame": {
        "x": 0,
        "y": 13,
        "width": 12,
        "height": 1
      },
      "frames": {},
      "color": "transparent",
