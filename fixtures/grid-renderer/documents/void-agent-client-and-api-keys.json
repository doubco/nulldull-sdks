      "hidden": false
    },
    {
      "padding": 0,
      "lineHeight": 1.5,
      "id": "markdown-2",
      "kind": "text",
      "name": "On 15 November 2026, workspaces gained API keys: public…",
      "text": "On 15 November 2026, workspaces gained API keys: public keys read published Grid content, and private keys also read Memory from your own apps.",
      "assetId": null,
