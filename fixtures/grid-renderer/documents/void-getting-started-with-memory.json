    {
      "padding": 0,
      "lineHeight": 1.5,
      "id": "markdown-1",
      "kind": "text",
      "name": "NullDull is in invite-only early access. Join the waiting…",
      "text": "NullDull is in invite-only early access. Join the waiting list from the NullDull home page; we’ll be in touch when access is ready, without a promised date.",
      "assetId": null,
      "frame": {
        "x": 0,
        "y": 1,
        "width": 12,
        "height": 1
      },
      "frames": {},
