{
  "name": "@nulldull/sdk",
  "version": "0.1.0",
  "description": "Official NullDull SDK for Node.js and browsers: Grid published content, read-only Memory and Locale export with workspace API keys.",
  "license": "MIT",
  "author": "NullDull",
  "homepage": "https://nulldull.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doubco/nulldull-sdks.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://github.com/doubco/nulldull-sdks/issues"
  },
  "keywords": [
    "nulldull",
    "sdk",
    "grid",
    "memory",
    "locale",
    "i18n",
    "cms",
    "api"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:live": "vitest run test/live.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
