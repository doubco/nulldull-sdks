{
  "name": "@nulldull/react",
  "version": "0.1.0",
  "description": "React hooks for NullDull: Grid published content, read-only Memory and Locale formats on top of @nulldull/sdk.",
  "license": "MIT",
  "author": "NullDull",
  "homepage": "https://nulldull.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doubco/nulldull-sdks.git",
    "directory": "react"
  },
  "bugs": {
    "url": "https://github.com/doubco/nulldull-sdks/issues"
  },
  "keywords": [
    "nulldull",
    "react",
    "hooks",
    "sdk",
    "grid",
    "memory",
    "locale",
    "cms"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "@nulldull/sdk": "^0.1.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@nulldull/sdk": "file:../node",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^18.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
